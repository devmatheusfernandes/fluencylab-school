# Copie para .env.local e preencha. NUNCA suba o .env.local para o GitHub.

# ── Lista de espera (banco) ────────────────────────────────────────────
# Use um banco Neon EXCLUSIVO desta lista (projeto novo no Neon, plano grátis serve).
# Propositalmente NÃO usamos a variável genérica DATABASE_URL, para este site
# nunca gravar por engano no banco de outro projeto.
# Sem esta variável: em desenvolvimento os cadastros só aparecem no log do terminal;
# em produção o formulário responde "indisponível" (para você não perder cadastros sem perceber).
WAITLIST_DATABASE_URL=

# ── Painel privado (/painel?key=...) e exportação CSV ──────────────────
# Escolha uma chave longa e aleatória (ex.: gere com: openssl rand -hex 24).
# Sem esta variável, o painel fica desligado (404).
ADMIN_KEY=

# ── Aparência e textos (opcionais) ─────────────────────────────────────
NEXT_PUBLIC_PRODUCT_NAME="Fluency Lab School"
NEXT_PUBLIC_DOMAIN="fluencylab.school"
NEXT_PUBLIC_SITE_URL="https://fluencylab.school"
# E-mail que aparece na política de privacidade para pedidos de dados (LGPD).
NEXT_PUBLIC_CONTACT_EMAIL=
# "true" mostra a proposta de preço (R$ 89 + R$ 15 por aluno ativo) na landing e na demo.
# Deixe vazio/false no início: o formulário pergunta quanto a pessoa pagaria ANTES de ela ver preço.
NEXT_PUBLIC_SHOW_PRICING=
